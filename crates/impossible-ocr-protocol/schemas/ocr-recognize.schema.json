{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image_base64", "metadata"],
  "properties": {
    "image_base64": { "type": "string", "minLength": 1, "maxLength": 44739244 },
    "metadata": {
      "type": "object",
      "required": ["format", "encoded_bytes", "width", "height"],
      "properties": {
        "format": { "enum": ["png", "jpeg"] },
        "encoded_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "language": { "const": "english" },
        "include_words": { "type": "boolean" },
        "minimum_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
